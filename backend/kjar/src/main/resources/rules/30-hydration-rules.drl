package rules;

import com.sbnz.model.ClinicalSignal;
import com.sbnz.model.HydrationIntakeEvent;

rule "hydration mild concern"
salience 60
when
    HydrationIntakeEvent($id : childId, intakePercent < 85, intakePercent >= 70)
    not ClinicalSignal(childId == $id, type == "HYDRATION_MILD")
then
    insert(new ClinicalSignal($id, "HYDRATION_MILD", "hydration intake is mildly reduced"));
end

rule "hydration moderate concern intake range"
salience 61
when
    HydrationIntakeEvent($id : childId, intakePercent < 70, intakePercent >= 50, poorFeeding == false)
    not ClinicalSignal(childId == $id, type == "HYDRATION_MODERATE")
then
    insert(new ClinicalSignal($id, "HYDRATION_MODERATE", "hydration is moderately reduced or poor feeding is present"));
end

rule "hydration moderate concern poor feeding"
salience 61
when
    HydrationIntakeEvent($id : childId, poorFeeding == true)
    not ClinicalSignal(childId == $id, type == "HYDRATION_MODERATE")
then
    insert(new ClinicalSignal($id, "HYDRATION_MODERATE", "hydration is moderately reduced or poor feeding is present"));
end

rule "hydration severe concern"
salience 62
when
    HydrationIntakeEvent($id : childId, intakePercent < 50)
    not ClinicalSignal(childId == $id, type == "HYDRATION_SEVERE")
then
    insert(new ClinicalSignal($id, "HYDRATION_SEVERE", "hydration is severely reduced"));
end

rule "hydration feeding refusal high risk intake below 60"
salience 63
when
    HydrationIntakeEvent($id : childId, intakePercent < 60, poorFeeding == false)
    not ClinicalSignal(childId == $id, type == "FEEDING_REFUSAL_HIGH_RISK")
then
    insert(new ClinicalSignal($id, "FEEDING_REFUSAL_HIGH_RISK", "feeding is significantly reduced and raises concern for escalation"));
end

rule "hydration feeding refusal high risk poor feeding below 70"
salience 63
when
    HydrationIntakeEvent($id : childId, poorFeeding == true, intakePercent < 70)
    not ClinicalSignal(childId == $id, type == "FEEDING_REFUSAL_HIGH_RISK")
then
    insert(new ClinicalSignal($id, "FEEDING_REFUSAL_HIGH_RISK", "feeding is significantly reduced and raises concern for escalation"));
end
