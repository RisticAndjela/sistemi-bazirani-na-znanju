rule "vitals tachypnea 2-3 months"
salience 85
when
    ChildProfile($id : childId, ageInMonths >= 2, ageInMonths <= 3)
    RespiratoryAssessmentEvent(childId == $id, respiratoryRate >= 50, respiratoryRate < 70)
    not ClinicalSignal(childId == $id, type == "TACHYPNEA")
then
    insert(new ClinicalSignal($id, "TACHYPNEA", "respiratory rate is above age-adjusted tachypnea threshold"));
end

