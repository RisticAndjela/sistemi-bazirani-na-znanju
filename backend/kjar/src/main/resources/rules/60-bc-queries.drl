package rules;

import com.sbnz.model.ClinicalSignal;
import com.sbnz.model.Recommendation;
import com.sbnz.model.SignalCategoryLink;

query "isSignalInCategory"(String $signalType, String $category)
    SignalCategoryLink(childType == $signalType, parentCategory == $category)
or
    SignalCategoryLink(childType == $signalType, $parent : parentCategory)
    isSignalInCategory($parent, $category)
end

query "isSafeForHomeMonitoring"(Long $childId)
    exists Recommendation(childId == $childId, action == "LOW_RISK_HOME_MONITORING")
end

query "getEscalationReasons"(Long $childId, String $type, String $reason)
    ClinicalSignal(childId == $childId, type == $type, reason == $reason)
end

query "getRequiredAction"(Long $childId, String $action, String $explanation)
    Recommendation(childId == $childId, action == $action, explanation == $explanation)
end

query "hasEmergencyAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "EMERGENCY_RESPONSE")
end

query "hasUrgentHospitalAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "URGENT_HOSPITAL_ASSESSMENT")
end

query "hasSameDayReviewAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "NEEDS_SAME_DAY_CLINICAL_REVIEW")
end

query "hasLowRiskAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "LOW_RISK_HOME_MONITORING")
end

query "getRespiratoryCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "RR_BORDERLINE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "TACHYPNEA")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "TACHYPNEA_SEVERE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "BREATHING_EFFORT_MILD")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "BREATHING_EFFORT_SEVERE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "OXYGEN_MONITOR_ZONE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "HYPOXEMIA_MODERATE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "HYPOXEMIA_SEVERE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "RAPID_OXYGEN_DROP_2H")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "BREATHING_EFFORT_ESCALATION_6H")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "PERSISTENT_LOW_SATURATION_6H")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "PERSISTENT_TACHYPNEA_12H")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "RESP_DISTRESS_GRUNTING")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "RESP_DISTRESS_INDRAWING")
end

query "getHydrationCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "HYDRATION_MILD")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "HYDRATION_MODERATE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "HYDRATION_SEVERE")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "FEEDING_REFUSAL_HIGH_RISK")
end

query "getRiskProfileCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "RISK_PROFILE_HIGH")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_2_3_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_4_5_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_6_11_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_12_18_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_19_24_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_25_36_MONTHS")
or
    ClinicalSignal(childId == $childId, $type : type, $reason : reason, type == "AGE_BAND_37_60_MONTHS")
end

query "getHomeMonitoringBlockers"(Long $childId, String $blockerType, String $blockerReason)
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "TACHYPNEA")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "TACHYPNEA_SEVERE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "HYPOXEMIA_MODERATE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "HYPOXEMIA_SEVERE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "BREATHING_EFFORT_MILD")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "BREATHING_EFFORT_SEVERE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "HYDRATION_MODERATE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "HYDRATION_SEVERE")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "FEEDING_REFUSAL_HIGH_RISK")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "EMERGENCY_RED_FLAG")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "RAPID_OXYGEN_DROP_2H")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "BREATHING_EFFORT_ESCALATION_6H")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "PERSISTENT_LOW_SATURATION_6H")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "PERSISTENT_TACHYPNEA_12H")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "RESP_DISTRESS_GRUNTING")
or
    ClinicalSignal(childId == $childId, $blockerType : type, $blockerReason : reason, type == "RESP_DISTRESS_INDRAWING")
end
