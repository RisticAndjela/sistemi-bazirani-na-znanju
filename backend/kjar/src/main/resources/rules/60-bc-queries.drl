package rules;

import com.sbnz.model.ClinicalSignal;
import com.sbnz.model.Recommendation;
import com.sbnz.model.SignalCategoryLink;

query "isSafeForHomeMonitoring"(Long $childId)
    exists Recommendation(childId == $childId, action == "LOW_RISK_HOME_MONITORING")
end

query "getEscalationReasons"(Long $childId, String $type, String $reason)
    ClinicalSignal(childId == $childId, type == $type, reason == $reason)
end

query "getRequiredAction"(Long $childId, String $action, String $explanation)
    Recommendation(childId == $childId, action == $action, explanation == $explanation)
end

query "hasEmergencyAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "EMERGENCY_RESPONSE")
end

query "hasUrgentHospitalAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "URGENT_HOSPITAL_ASSESSMENT")
end

query "hasSameDayReviewAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "NEEDS_SAME_DAY_CLINICAL_REVIEW")
end

query "hasLowRiskAction"(Long $childId)
    exists Recommendation(childId == $childId, action == "LOW_RISK_HOME_MONITORING")
end

query "getRespiratoryCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(
        childId == $childId,
        type == $type,
        reason == $reason,
        type in ("RR_BORDERLINE", "TACHYPNEA", "TACHYPNEA_SEVERE", "BREATHING_EFFORT_MILD",
                 "BREATHING_EFFORT_SEVERE", "OXYGEN_MONITOR_ZONE", "HYPOXEMIA_MODERATE",
                 "HYPOXEMIA_SEVERE", "RAPID_OXYGEN_DROP_2H", "BREATHING_EFFORT_ESCALATION_6H",
                 "PERSISTENT_LOW_SATURATION_6H", "PERSISTENT_TACHYPNEA_12H",
                 "RESP_DISTRESS_GRUNTING", "RESP_DISTRESS_INDRAWING")
    )
end

query "getHydrationCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(
        childId == $childId,
        type == $type,
        reason == $reason,
        type in ("HYDRATION_MILD", "HYDRATION_MODERATE", "HYDRATION_SEVERE", "FEEDING_REFUSAL_HIGH_RISK")
    )
end

query "getRiskProfileCategories"(Long $childId, String $type, String $reason)
    ClinicalSignal(
        childId == $childId,
        type == $type,
        reason == $reason,
        type in ("RISK_PROFILE_HIGH", "AGE_BAND_2_3_MONTHS", "AGE_BAND_4_5_MONTHS",
                 "AGE_BAND_6_11_MONTHS", "AGE_BAND_12_18_MONTHS", "AGE_BAND_19_24_MONTHS",
                 "AGE_BAND_25_36_MONTHS", "AGE_BAND_37_60_MONTHS")
    )
end

query "getHomeMonitoringBlockers"(Long $childId, String $blockerType, String $blockerReason)
    ClinicalSignal(
        childId == $childId,
        type == $blockerType,
        reason == $blockerReason,
        type in ("TACHYPNEA", "TACHYPNEA_SEVERE", "HYPOXEMIA_MODERATE", "HYPOXEMIA_SEVERE",
                 "BREATHING_EFFORT_MILD", "BREATHING_EFFORT_SEVERE", "HYDRATION_MODERATE",
                 "HYDRATION_SEVERE", "FEEDING_REFUSAL_HIGH_RISK", "EMERGENCY_RED_FLAG",
                 "RAPID_OXYGEN_DROP_2H", "BREATHING_EFFORT_ESCALATION_6H",
                 "PERSISTENT_LOW_SATURATION_6H", "PERSISTENT_TACHYPNEA_12H",
                 "RESP_DISTRESS_GRUNTING", "RESP_DISTRESS_INDRAWING")
    )
end
