package rules;

import com.sbnz.model.ChildProfile;
import com.sbnz.model.ClinicalSignal;
import com.sbnz.model.RespiratoryAssessmentEvent;

rule "cep rapid oxygen drop in 2h"
salience 130
when
    ChildProfile($id : childId)
    $e1 : RespiratoryAssessmentEvent($spo1 : spo2, childId == $id)
    RespiratoryAssessmentEvent(this != $e1, $spo2 : spo2, childId == $id, $spo2 <= $spo1 - 2, this after[0s,2h] $e1)
    not ClinicalSignal(childId == $id, type == "RAPID_OXYGEN_DROP_2H")
then
    insert(new ClinicalSignal($id, "RAPID_OXYGEN_DROP_2H", "oxygen saturation dropped by at least 2 points within 2h"));
end

rule "cep breathing effort escalation in 6h from missing chest indrawing"
salience 125
when
    ChildProfile($id : childId)
    $e1 : RespiratoryAssessmentEvent($chest1 : chestIndrawing, childId == $id)
    RespiratoryAssessmentEvent(this != $e1, childId == $id, chestIndrawing == true, grunting == true, this after[0s,6h] $e1)
    eval(!$chest1)
    not ClinicalSignal(childId == $id, type == "BREATHING_EFFORT_ESCALATION_6H")
then
    insert(new ClinicalSignal($id, "BREATHING_EFFORT_ESCALATION_6H", "breathing effort worsened to combined chest indrawing and grunting within 6h"));
end

rule "cep breathing effort escalation in 6h from missing grunting"
salience 125
when
    ChildProfile($id : childId)
    $e1 : RespiratoryAssessmentEvent($grunting1 : grunting, childId == $id)
    RespiratoryAssessmentEvent(this != $e1, childId == $id, chestIndrawing == true, grunting == true, this after[0s,6h] $e1)
    eval(!$grunting1)
    not ClinicalSignal(childId == $id, type == "BREATHING_EFFORT_ESCALATION_6H")
then
    insert(new ClinicalSignal($id, "BREATHING_EFFORT_ESCALATION_6H", "breathing effort worsened to combined chest indrawing and grunting within 6h"));
end

rule "cep persistent low saturation in 6h"
salience 124
when
    ChildProfile($id : childId)
    $e1 : RespiratoryAssessmentEvent(childId == $id, spo2 <= 93)
    RespiratoryAssessmentEvent(this != $e1, childId == $id, spo2 <= 93, this after[0s,6h] $e1)
    not ClinicalSignal(childId == $id, type == "PERSISTENT_LOW_SATURATION_6H")
then
    insert(new ClinicalSignal($id, "PERSISTENT_LOW_SATURATION_6H", "oxygen saturation remained at or below 93 within repeated assessments over 6h"));
end

rule "cep persistent tachypnea in 12h 2-3 months"
salience 120
when
    ChildProfile($id : childId, ageInMonths >= 2, ageInMonths <= 3)
    $e1 : RespiratoryAssessmentEvent(childId == $id, respiratoryRate >= 50)
    RespiratoryAssessmentEvent(this != $e1, childId == $id, respiratoryRate >= 50, this after[0s,12h] $e1)
    not ClinicalSignal(childId == $id, type == "PERSISTENT_TACHYPNEA_12H")
then
    insert(new ClinicalSignal($id, "PERSISTENT_TACHYPNEA_12H", "tachypnea persisted across events within 12h window"));
end

